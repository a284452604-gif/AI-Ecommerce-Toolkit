{
    "app": {
        "name": "AI电商工具箱",
        "version": "1.2.3"
    },
    "window": {
        "width": 1200,
        "height": 800,
        "x": -1,
        "y": -1,
        "maximized": false
    },
    "ai_service": {
        "provider": "deepseek",
        "api_key": "",
        "model": "deepseek-chat",
        "base_url": "https://api.deepseek.com",
        "timeout": 30
    },
    "scraper": {
        "timeout": 15,
        "max_redirects": 5,
        "max_history": 50,
        "browser_enabled": true,
        "cookies": {
            "taobao": "",
            "tmall": "",
            "jd": "",
            "pdd": "",
            "douyin": ""
        }
    },
    "appearance": {
        "theme": "light",
        "font_family": "Microsoft YaHei UI",
        "font_size": 10
    },
    "logging": {
        "level": "INFO",
        "max_bytes": 5242880,
        "backup_count": 10
    }
}
