/* ============================================
   AI电商工具箱 - 主样式表
   现代扁平化设计 / 浅色主题
   ============================================ */

/* 全局 */
QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #1a1a2e;
}

/* 主窗口背景 */
QMainWindow {
    background-color: #f5f5f7;
}

/* ============================================
   侧边栏
   ============================================ */
#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e0e0e0;
}

#SidebarLogo {
    color: #4a47a3;
    font-size: 14pt;
    font-weight: bold;
    background-color: #ffffff;
    border-bottom: 1px solid #f0f0f0;
}

#SidebarVersion {
    color: #999999;
    font-size: 9pt;
    border-top: 1px solid #f0f0f0;
}

/* 导航项 */
#NavItem {
    text-align: left;
    padding: 14px 20px;
    border: none;
    border-radius: 0px;
    background: transparent;
    color: #555555;
    font-size: 10pt;
}
#NavItem:hover {
    background-color: #f0f0f5;
    color: #1a1a2e;
}
#NavItem:checked {
    background-color: #e8e8ff;
    color: #4a47a3;
    border-left: 3px solid #4a47a3;
    font-weight: bold;
}

/* ============================================
   卡片
   ============================================ */
#CardWidget {
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #e8e8e8;
}
#CardWidget:hover {
    border-color: #4a47a3;
}
#CardTitle {
    color: #1a1a2e;
    font-size: 12pt;
    font-weight: bold;
}
#CardDescription {
    color: #666666;
    font-size: 9pt;
}
#CardStatus {
    color: #999999;
    font-size: 8pt;
}

/* ============================================
   按钮
   ============================================ */
QPushButton {
    background-color: #4a47a3;
    color: white;
    border: none;
    padding: 8px 24px;
    border-radius: 6px;
    font-size: 10pt;
}
QPushButton:hover {
    background-color: #5a57b3;
}
QPushButton:pressed {
    background-color: #3a3793;
}
QPushButton:disabled {
    background-color: #c0c0c0;
    color: #e0e0e0;
}

/* 次要按钮 */
QPushButton#SecondaryButton {
    background-color: #f0f0f5;
    color: #555555;
    border: 1px solid #d0d0d0;
}
QPushButton#SecondaryButton:hover {
    background-color: #e0e0e8;
    color: #1a1a2e;
}

/* ============================================
   输入控件
   ============================================ */
QLineEdit, QSpinBox, QComboBox, QTextEdit {
    padding: 6px 10px;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background: white;
    selection-background-color: #4a47a3;
    selection-color: white;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QTextEdit:focus {
    border-color: #4a47a3;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* ============================================
   分组容器
   ============================================ */
QGroupBox {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    color: #333333;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #f5f5f7;
}

/* ============================================
   标签
   ============================================ */
QLabel#PageTitle {
    font-size: 18pt;
    font-weight: bold;
    color: #1a1a2e;
}
QLabel#PageSubtitle {
    font-size: 10pt;
    color: #999999;
}
QLabel#AboutAppName {
    font-size: 20pt;
    font-weight: bold;
    color: #4a47a3;
}
QLabel#AboutVersion {
    font-size: 12pt;
    color: #666666;
}
QLabel#AboutInfo {
    font-size: 10pt;
    color: #555555;
}

/* ============================================
   滚动条
   ============================================ */
QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    height: 8px;
    background: transparent;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c0c0c0;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ============================================
   状态栏
   ============================================ */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
    color: #999999;
    font-size: 9pt;
}

/* ============================================
   链接标签
   ============================================ */
QLabel#LinkLabel {
    color: #4a47a3;
    text-decoration: underline;
}
QLabel#LinkLabel:hover {
    color: #5a57b3;
}
